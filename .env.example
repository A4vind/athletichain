# --- Database ---
# `pnpm start:all` runs a built-in PostgreSQL (no Docker) and sets DATABASE_URL itself.
# To use your own Postgres instead (e.g. `docker compose up -d`), set EMBEDDED_DB=0.
EMBEDDED_DB=1
DATABASE_URL=postgres://athletichain:athletichain@localhost:54329/athletichain

# --- Auth: a long random string, e.g. `openssl rand -base64 48` ---
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Public URL used in QR codes ---
APP_URL=http://localhost:3000

# --- Blockchain ---
# localhost = local Hardhat chain (pnpm chain + pnpm setup:local); sepolia = public testnet
CHAIN_NETWORK=localhost
# Contract address is read from contracts/deployments/<network>.json unless set here
CHAIN_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=
# Testnet-only wallet that pays gas. NEVER a real wallet, never commit it.
RELAYER_PRIVATE_KEY=
CONTRACT_ADDRESS=
# Comma-separated coach wallets to register when deploying locally
VERIFIER_ADDRESSES=

# --- Hosting on Vercel (see docs/DEPLOY-VERCEL.md) ---
# DATABASE_URL = the Neon *pooled* connection string (host contains "-pooler").
# Keep each serverless function to a few connections:
# PG_POOL_MAX=2
# Evidence files go to a private Vercel Blob store when this is set (Vercel adds it for you):
# BLOB_READ_WRITE_TOKEN=

# --- Demo day ---
# Shows the admin "simulate database tampering" tools even in a production build.
# Leave unset for a real deployment. (They are always on with `pnpm dev`.)
DEMO_TOOLS=1
