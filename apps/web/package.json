{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @athletichain/canonical build && next build",
    "start": "next start",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:reset": "tsx src/server/db/reset.ts && tsx src/server/db/migrate.ts && tsx src/server/db/seed.ts",
    "chain:setup": "tsx scripts/chain-setup.ts",
    "chain:sepolia": "tsx scripts/sepolia-setup.ts"
  },
  "dependencies": {
    "@athletichain/canonical": "workspace:*",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@node-rs/argon2": "^2.0.0",
    "@vercel/blob": "2.8.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.36.4",
    "ethers": "^6.17.0",
    "jose": "^5.9.6",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.28.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
